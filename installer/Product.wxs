<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="CircleSearch for Windows"
           Manufacturer="CircleSearch Contributors"
           Version="1.0.1.0"
           UpgradeCode="8A7F9B14-6D2C-4E91-9A55-1C3E8B4D2026"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\Resources\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="CircleSearchProgram" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="CircleSearch for Windows" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="CircleSearch for Windows" Level="1">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcuts" Guid="4B9D2E6F-8C1A-4D3B-9F70-2E5A6C8B1026">
        <Shortcut Id="StartMenuShortcut"
                  Name="CircleSearch for Windows"
                  Description="Circle to Search for Windows"
                  Target="[INSTALLFOLDER]CircleSearch.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="CircleSearch for Windows"
                  Description="Circle to Search for Windows"
                  Target="[INSTALLFOLDER]CircleSearch.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\CircleSearchForWindows"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Package>
</Wix>
