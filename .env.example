# CircleSearch: необязательные начальные настройки (копируйте в .env рядом с CircleSearch.exe).
# Значения из settings.json (окно настроек) имеют приоритет над .env.

# Язык интерфейса: auto или код языка (en, kk, ru, es, de, fr, pt, tr, uk, zh, ja, ko)
UI_LANGUAGE=auto
# Тема: Dark или Light
THEME=Dark
# Монитор для захвата: Cursor или ActiveWindow
TARGET_MONITOR_MODE=Cursor
# Задержка удержания клавиши Win, мс (200-2000)
LONG_PRESS_MS=400

# Каталог settings.json (по умолчанию %LocalAppData%\CircleSearch) задаётся переменной окружения CIRCLESEARCH_CONFIG_DIR
